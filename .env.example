# Copia este fichero a .env.local y rellénalo. No subas .env.local al repo.
#
# Supabase local: arranca con `pnpm supabase start` y mira los valores con
# `pnpm supabase status -o env`.

# URL de la API de Supabase (local: puerto 54321).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Clave pública (publishable). En CLI antiguos es la anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key-local>

# Clave de servicio. Solo para scripts/ y e2e/; nunca la importes desde src/.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-local>
