{
  "name": "clubos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests --project node --project ui",
    "test:db": "supabase test db",
    "test:int": "vitest run --project int",
    "test:e2e": "playwright test",
    "tokens": "tsx scripts/tokens-to-css.ts",
    "seed": "tsx scripts/seed.ts",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "check:guards": "bash scripts/check-guards.sh"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "date-fns": "^4.4.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.1",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "uuid": "^14.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.8.1"
}
